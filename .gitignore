# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Virtual environment
venv/
.venv/

# Runtime artifacts -- logs/ is mostly ignored, but experiment evidence
# referenced from the knowledge docs is kept.
logs/*
!logs/*vram*.log
!logs/canny_experiment/
!logs/diff_experiment/
!logs/vectorize_experiment/
!logs/sdxl_output_*.png

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
MILESTONES.md.bak

# Style-LoRA training assets (著作権を含む可能性 / リポに置かない)
training/*/raw/
training/lora_runs/
training/lora/*.safetensors
training/lora/*.bin
training/lora/*.pt
# dataset (リサイズ済み画像 + caption) も漏れ防止のため除外
training/*/dataset/

# 学習成果物 (LoRA 重み / checkpoint / optimizer) はリポに置かない (~1GB)
models/
# LoRA 学習データセット (著作権を含む可能性 / 特に matsumoto)
sketch_variations/lora_winners_dataset/
sketch_variations/matsumoto_lora_dataset/
